// creativelynanda.co.za on Cloudflare Workers via @opennextjs/cloudflare.
// Secrets are set with `wrangler secret put` / bulk only. Never put them here.
//
// PRODUCTION = top level (Worker `creativelynanda`, zone routes added at cutover via the API,
// see docs/migration/cutover-runbook.md). STAGING = env.staging (workers.dev only).
// NO cron triggers anywhere (this site has no crons).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creativelynanda",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Site talks mostly to Supabase (remote DB): run the Worker near it.
  "placement": { "mode": "smart" },
  "triggers": { "crons": [] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "creativelynanda" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "creativelynanda-inc-cache" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "images": { "binding": "IMAGES" },
  // Workers Rate Limiting. namespace_id must be unique across the account (5101/5102 Sanyu, 5201/5202 Mirembe).
  "ratelimits": [{ "name": "RL_10_60", "namespace_id": "5301", "simple": { "limit": 10, "period": 60 } }],

  "env": {
    "staging": {
      "name": "creativelynanda-staging",
      "workers_dev": true,
      "triggers": { "crons": [] },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "creativelynanda-staging" }],
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "creativelynanda-inc-cache-staging" }],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
        ]
      },
      "images": { "binding": "IMAGES" },
      "ratelimits": [{ "name": "RL_10_60", "namespace_id": "5302", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
