// creativelynanda.co.za on Cloudflare Workers via @opennextjs/cloudflare.
// Secrets are set with `wrangler secret put` / bulk only. Never put them here.
//
// STAGING ONLY until the owner approves cutover: workers.dev, NO routes / custom domain,
// NO cron triggers (this site has no crons). Cutover = add routes (docs/migration/cutover-runbook.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creativelynanda-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Site talks mostly to Supabase (remote DB): run the Worker near it.
  "placement": { "mode": "smart" },
  "triggers": { "crons": [] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "creativelynanda-staging" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "creativelynanda-inc-cache-staging" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "images": { "binding": "IMAGES" }
}
